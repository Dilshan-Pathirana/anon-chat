{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "baseUrl": ".",
    "paths": {
      "*": ["*", "types/*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "lib/**/*",
    "config/**/*",
    "types/**/*",
    "models/**/*",
    "middleware/**/*",
    "routes/**/*",
    "*.ts"
  ]
}
